# BeePM Environment Configuration
# Copy this file to .env and fill in your values

# GitHub OAuth Configuration (for beepm login)
BEEPM_GITHUB_CLIENT_ID=your_github_client_id_here
BEEPM_GITHUB_CLIENT_SECRET=your_github_client_secret_here

# OpenAI API Configuration (for content moderation in beepm publish)
# Optional - if not set, content moderation will be skipped with a warning
OPENAI_API_KEY=your_openai_api_key_here

# Cloudflare R2 Configuration (for beepm publish)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=beepm

# BeePM Registry URL (optional)
BEEPM_REGISTRY_URL=https://r2.beepm.com/registry.json

