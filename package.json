{
    "name": "beepm-monorepo",
    "private": true,
    "version": "1.0.0",
    "description": "BeePM - package manager for BEEmod",
    "author": "Areng",
    "type": "module",
    "workspaces": [
        "core",
        "server",
        "cli",
        "app"
    ],
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "test": "npm test --workspaces --if-present",
        "dev:server": "npm run dev -w @beepm/server",
        "dev:app": "npm run dev -w @beepm/app",
        "format": "prettier --write .",
        "publish": "node app/scripts/release.js"
    },
    "devDependencies": {
        "prettier": "^3.6.2"
    }
}
