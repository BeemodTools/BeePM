# BeePM registry server settings. On Railway, set these as service variables.
# Locally, none are required: the server uses a PGlite database and a folder in server/.data,
# and offers "Continue with a test account" on the login page.

# --- Set automatically by Railway ---
# PORT=8080
# RAILWAY_PUBLIC_DOMAIN=beepm-registry-production.up.railway.app   (used as PUBLIC_URL if that isn't set)
NODE_ENV=production

# Public base URL of this server. Must match the OAuth callback URLs below.
PUBLIC_URL=https://beepm-registry-production.up.railway.app

# Postgres: reference the Railway Postgres service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Railway bucket: reference the bucket's variables, e.g. ${{Packages.BUCKET}}
BUCKET=
ENDPOINT=
REGION=auto
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
# Older Railway buckets need path-style URLs (the bucket's Credentials tab says which)
# S3_FORCE_PATH_STYLE=true

# Discord app (https://discord.com/developers/applications), OAuth2 redirect:
#   <PUBLIC_URL>/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# GitHub OAuth app (https://github.com/settings/developers), callback URL:
#   <PUBLIC_URL>/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: a GitHub token (no scopes needed) for release imports and the BeePM 1 import,
# to avoid GitHub's low anonymous rate limit
GITHUB_API_TOKEN=

# Handles that become admins when they log in (comma-separated)
BOOTSTRAP_ADMINS=areng14

# Limits (defaults shown)
# MAX_UPLOAD_MB=512
# MIN_ACCOUNT_AGE_DAYS=30
# PUBLISHES_PER_HOUR=10
# PUBLISHES_PER_DAY=30
# TOKEN_DAYS=365
# UNPUBLISH_HOURS=72
# AUTH_SESSION_MINUTES=15

# Where BeePM 1's registry is (for POST /v1/admin/import-legacy)
# LEGACY_REGISTRY_URL=https://pub-adc08815222c4c608465419f2d5751a5.r2.dev/registry.json

# LOG_LEVEL=info
