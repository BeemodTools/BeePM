{
    "name": "@beepm/app",
    "main": "backend/main.js",
    "type": "module",
    "private": true,
    "version": "1.0.0",
    "description": "BeePM desktop app",
    "author": "Areng",
    "scripts": {
        "dev": "concurrently -k -s command-app -n vite,app \"vite\" \"electron .\"",
